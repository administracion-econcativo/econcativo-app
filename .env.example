# Configuración de Conexión a Supabase / PostgreSQL
# Reemplazar con los datos de tu proyecto de Supabase (Settings -> Database -> Connection String)

# Opción 1: Conexión directa a PostgreSQL (Recomendada para Flask)
# Formato Directo: postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Formato Pooler (Sesión): postgresql://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Opción 2: API de Supabase (Settings -> API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=

# Clave secreta para sesiones Flask
SECRET_KEY=econcativo_secret_key_2026_auth
